{
    "name": "numencode",
    "version": "0.0.1",
    "workspaces": ["packages/*"],
    "scripts": {
        "dev:cli": "bun run --watch packages/cli/src/index.tsx",
        "dev:server": "bun run --hot packages/server/src/index.ts",
        "build:cli": "bun run --filter @numencode/cli build",
        "link:cli": "bun run build:cli && cd packages/cli && bun link"
    },
    "dependencies": {
        "@types/node": "^25.9.1",
        "dotenv": "^18.0.4"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}